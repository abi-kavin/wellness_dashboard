# Backend Production Environment Variables Example
# Duplicate this file as .env in your production environment and update values

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/your-db-name
JWT_SECRET=your_long_random_jwt_secret
GEMINI_API_KEY=your_google_gemini_api_key

# The URL of your deployed frontend (e.g., https://your-wellness-dashboard.vercel.app)
FRONTEND_URL=https://your-frontend-url.vercel.app
